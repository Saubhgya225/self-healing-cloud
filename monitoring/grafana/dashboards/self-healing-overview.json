{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Platform Health & KPIs",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Application Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_requests_total[1m])) by (method)",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request Latency (P50 & P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_requests_total{http_status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))) * 100",
          "legendFormat": "Error Rate %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Self-Healing & Autoscaling Dynamics",
      "type": "row"
    },
    {
      "id": 4,
      "title": "Active Pod Replicas vs Desired",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(kube_pod_status_phase{namespace=\"self-healing-cloud\", phase=\"Running\"})",
          "legendFormat": "Running Pods"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_deployment_status_replicas_available{namespace=\"self-healing-cloud\", deployment=\"self-healing-app\"}",
          "legendFormat": "Available Replicas"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod Liveness & Readiness Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "self_healing_pod_liveness_status",
          "legendFormat": "Liveness: {{pod_name}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "self_healing_pod_readiness_status",
          "legendFormat": "Readiness: {{pod_name}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["self-healing", "kubernetes", "cloud"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Self-Healing Cloud Infrastructure Overview",
  "uid": "self-healing-overview"
}
